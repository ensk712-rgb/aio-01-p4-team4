# 복사해서 .env로 쓴다: cp .env.example .env && chmod 600 .env
# .env는 git에 올리지 않는다. 서버(aio-t4)에는 scp로 따로 옮긴다.
# 값은 팀장에게 비공개로 받는다. 이 파일에는 이름만 둔다.

# 팀 키 (X-Team-Key). 이 이름 하나를 모두가 쓴다.
#   시험:            uv run --env-file .env tools/flow.py test cases/common.json --webhook ticketmoa-support
#   Credential 등록: set -a; . ./.env; set +a; bash tools/register-team-key.sh
TM_TEAM_KEY=

# 웹 화면
TM_N8N_URL=http://localhost:5678
TM_DATA_API_URL=http://localhost:8800
TM_HOST=127.0.0.1
TM_PORT=8080
TM_DISCORD_WEBHOOK_URL=

# (선택) 기본값과 다를 때만 # 를 지운다. 빈 값으로 두면 기본값을 못 쓴다.
# FLOW_PY=/home/<계정>/aio-01d4-stu/Last3Mon/78/tools/flow.py
# N8N_CONTAINER=day65-n8n-n8n-1

