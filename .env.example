# 복사해서 .env 로 쓴다 (git에 올리지 않는다). 서버에는 scp로 따로 옮긴다.
# OpenAI API 키 (n8n Credential "OpenAI"로 들어간다)
OPENAI_API_KEY=
# 웹훅 Header Auth 값 (X-Team-Key). 비워 두면 deploy/server/setup.sh 가 난수로 만든다.
TM_TEAM_KEY=
# 데이터 API X-Api-Key (연습용 API는 검사하지 않지만 Credential 이름에 맞춰 둔다)
TM_DATA_API_KEY=ticketmoa-data
# 웹앱
TM_HOST=127.0.0.1
TM_PORT=8080
TM_N8N_URL=http://localhost:5678
TM_DATA_API_URL=http://localhost:8800
