# 복사해서 .env로 쓴다: cp .env.example .env  (.env는 git에 올리지 않는다, 서버에는 scp로 따로)
# 값은 팀장에게 받는다. 이 파일에는 이름만 둔다.

# 웹 화면 (webapp/app.py가 읽음)
TM_TEAM_KEY=
TM_N8N_URL=http://localhost:5678
TM_DATA_API_URL=http://localhost:8800
TM_HOST=127.0.0.1
TM_PORT=8080

# 시험 (tools/flow.py, tools/register-team-key.sh) · .env를 자동으로 읽지 않으므로 셸에서 넣는다
# FLOW_WEBHOOK_KEY=<팀 키>
# TEAM_KEY=<팀 키>

# OpenAI 키는 여기 두지 않는다: ~/aio-01d4-stu/Last3Mon/.env → Last3Mon/65/n8n/register-credentials.sh

# deploy/ 스크립트(MVP 전체 배포)만 쓰는 값. OPENAI_API_KEY를 비워 두면 과정용 Credential(openAiCourse0001)에 연결한다.
# TM_DATA_API_KEY=ticketmoa-data
