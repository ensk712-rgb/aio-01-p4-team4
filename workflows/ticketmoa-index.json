{
  "name": "ticketmoa-index",
  "nodes": [
    {
      "name": "Index webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "ticketmoa-index",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ticketmoaTeamKey1",
          "name": "ticketmoa-team-key"
        }
      }
    },
    {
      "name": "Validate and make chunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        300
      ],
      "parameters": {
        "jsCode": "// Input contract: { documents: [{ doc, text }] }; text is Markdown with a top-level access_level declaration.\nconst body = $input.first()?.json?.body ?? {};\nconst documents = Array.isArray(body.documents) ? body.documents : [];\nconst issues = []; const validDocs = []; const chunks = [];\nconst contactPattern = /(?:\\b\\d{2,3}[-. ]\\d{3,4}[-. ]\\d{4}\\b|[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,})/i;\nfor (const entry of documents) {\n  const doc = String(entry?.doc ?? '').trim(); const text = typeof entry?.text === 'string' ? entry.text : ''; const errors = [];\n  if (!doc || !text) errors.push('doc 또는 text가 비어 있음');\n  const accessMatch = text.match(/^>\\s*access_level:\\s*(all|staff)\\b/im);\n  const sections = [...text.matchAll(/^##\\s+(.+)\\s*$/gm)];\n  if (sections.length < 3) errors.push(`## 절이 3개 미만 (${sections.length})`);\n  if (!accessMatch) errors.push('access_level이 없거나 all/staff 값이 아님');\n  const pieces = sections.map((match, index) => { const start = match.index + match[0].length; const end = index + 1 < sections.length ? sections[index + 1].index : text.length; return { section: match[1].trim(), text: text.slice(start, end).trim() }; });\n  if (pieces.some(piece => !piece.text)) errors.push('빈 ## 절이 있음');\n  if (contactPattern.test(text)) errors.push('연락처 형식 문자열이 포함됨');\n  if (errors.length) { issues.push({ doc: doc || null, stage: 'validation', errors }); continue; }\n  const access_level = accessMatch[1].toLowerCase(); validDocs.push({ doc, access_level });\n  for (const piece of pieces) chunks.push({ doc, section: piece.section, access_level, text: `# ${doc}\n## ${piece.section}\n${piece.text}`, isChunk: true });\n}\nconst lengths = chunks.map(chunk => chunk.text.length).sort((a, b) => a - b);\nconst median = lengths.length ? (lengths.length % 2 ? lengths[(lengths.length - 1) / 2] : (lengths[lengths.length / 2 - 1] + lengths[lengths.length / 2]) / 2) : 0;\nconst publicDocs = new Set(validDocs.filter(d => d.access_level === 'all').map(d => d.doc));\nconst staffDocs = new Set(validDocs.filter(d => d.access_level === 'staff').map(d => d.doc));\nconst stats = { input_document_count: documents.length, valid_document_count: validDocs.length, public_document_count: publicDocs.size, staff_document_count: staffDocs.size, chunk_count: chunks.length, chunk_length: { min: lengths[0] ?? 0, median, max: lengths.at(-1) ?? 0 }, issues };\nif (chunks.length) return chunks.map(chunk => ({ json: { ...chunk, __stats: stats } }));\nreturn [{ json: { isChunk: false, access_level: null, status: 'no_valid_chunks', __stats: stats } }];"
      }
    },
    {
      "name": "Build result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        520
      ],
      "parameters": {
        "jsCode": "// Counts come from validated chunks; the Store node's error output is reflected in issues.\nconst validation = $('Validate and make chunks').all().map(item => item.json);\nconst stats = validation.find(item => item.__stats)?.__stats ?? { input_document_count: 0, valid_document_count: 0, public_document_count: 0, staff_document_count: 0, chunk_count: 0, chunk_length: { min: 0, median: 0, max: 0 }, issues: [] };\nconst output = $input.all().map(item => item.json);\nconst storeErrors = output.filter(row => row.error || row.errorMessage || row.status === 'error').map(row => ({ doc: row.doc ?? null, section: row.section ?? null, stage: 'index', errors: [row.error?.message ?? row.errorMessage ?? row.message ?? 'Vector Store 저장 실패'] }));\nconst outcome = stats.chunk_count === 0 ? 'no_valid_chunks' : storeErrors.length ? 'store_error' : 'store_output_received';\nreturn [{ json: { ...stats, issues: [...(stats.issues ?? []), ...storeErrors], outcome } }];"
      }
    },
    {
      "name": "Send result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1060,
        520
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    },
    {
