      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.3,
      "position": [
        1800,
        0
      ],
      "parameters": {
        "mode": "load",
        "memoryKey": {
          "__rl": true,
          "mode": "list",
          "value": "ticketmoa_kb_v1_staff",
          "cachedResultName": "ticketmoa_kb_v1_staff"
        },
        "prompt": "={{ $('검색 준비').first().json.query }}",
        "topK": 100,
        "includeDocumentMetadata": true
      },
      "onError": "continueErrorOutput",
      "alwaysOutputData": true
    },
    {
      "name": "스태프 검색 임베딩",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        1800,
        150
      ],
      "parameters": {
        "model": "text-embedding-3-large",
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "openAiCourse0001",
