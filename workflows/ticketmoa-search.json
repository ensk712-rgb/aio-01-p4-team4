    },
    {
      "name": "일반 결과 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst failed = items.some(i => i.json.error);\nconst raw = items.filter(i => i.json.document).map(i => ({\n  doc: i.json.document.metadata?.doc,\n  section: i.json.document.metadata?.section,\n  score: Math.round((i.json.score ?? 0) * 1000) / 1000,\n  text: i.json.document.pageContent ?? '',\n}));\nreturn [{ json: { failed, raw } }];"
      }
    },
    {
      "name": "스태프 권한?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1500,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $('검색 준비').first().json.search_staff }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "스태프 결과 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        0
      ],
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst failed = items.some(i => i.json.error);\nconst raw = items.filter(i => i.json.document).map(i => ({\n  doc: i.json.document.metadata?.doc,\n  section: i.json.document.metadata?.section,\n  score: Math.round((i.json.score ?? 0) * 1000) / 1000,\n  text: i.json.document.pageContent ?? '',\n}));\nreturn [{ json: { failed, raw } }];"
      }
    },
    {
      "name": "검색 결과 조립",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        0
      ],
      "parameters": {
        "jsCode": "const p = $('검색 준비').first().json;\nconst a = $('일반 결과 정리').first().json;\nconst s = $('스태프 결과 정리').isExecuted ? $('스태프 결과 정리').first().json : { failed: false, raw: [] };\nconst scope = p.scope.length ? new Set(p.scope) : null;\nconst indexed = a.raw.length > 0 || (p.search_staff && s.raw.length > 0);\nconst hits = [...a.raw, ...(p.search_staff ? s.raw : [])]\n  .filter(h => h.doc && (!scope || scope.has(h.doc)))\n  .sort((x, y) => y.score - x.score)\n  .filter((h, i, all) => all.findIndex(x => x.doc === h.doc && x.section === h.section) === i)\n  .slice(0, p.top_k);\nconst out = { hits, top_score: hits.length ? hits[0].score : 0, indexed };\nif (a.failed || (p.search_staff && s.failed)) out.error = 'search_failed';\nelse if (!indexed) out.error = 'index_unavailable';\nif (p.search_staff) out.staff_indexed = s.raw.length > 0;\nreturn [{ json: out }];"
      }
    },
    {
      "name": "빈 질문 결과",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        75
      ],
      "parameters": {
        "jsCode": "const p = $('검색 준비').first().json;\nif (p.staff_search_disabled) return [{ json: { hits: [], top_score: 0, indexed: false, staff_indexed: false, error: 'staff_search_disabled' } }];\nreturn [{ json: { hits: [], top_score: 0, indexed: null, error: 'empty_query' } }];"
      }
    },
    {
      "name": "검색 결과 응답",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2700,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    }
