{
  "name": "ticketmoa-search",
  "nodes": [
    {
      "name": "검색 요청 수신",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "ticketmoa-search",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ticketmoaTeamKey1",
          "name": "ticketmoa-team-key"
        }
      }
    },
    {
      "name": "검색 준비",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "jsCode": "const b = $input.first()?.json?.body ?? {};\nconst staffSearchDisabled = b.access_level === 'staff';\nconst scope = Array.isArray(b.scope) ? [...new Set(b.scope.map(String).map(x => x.trim()).filter(Boolean))] : [];\nreturn [{ json: {\n  // Temporary fail-closed policy: no request can select the staff store until\n  // support passes an authenticated identity through an approved trust boundary.\n  query: staffSearchDisabled ? '' : String(b.query ?? '').trim().slice(0, 700),\n  access_level: 'all',\n  search_staff: false,\n  staff_search_disabled: staffSearchDisabled,\n  top_k: Math.min(Math.max(Number(b.top_k) || 3, 1), 8),\n  scope,\n} }];"
      }
    },
    {
      "name": "질문 있음?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.query.length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "일반 저장소 검색",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.3,
      "position": [
        900,
        -75
      ],
      "parameters": {
        "mode": "load",
        "memoryKey": {
          "__rl": true,
          "mode": "list",
          "value": "ticketmoa_kb_v1_all",
          "cachedResultName": "ticketmoa_kb_v1_all"
        },
        "prompt": "={{ $json.query }}",
        "topK": 100,
        "includeDocumentMetadata": true
      },
      "onError": "continueErrorOutput",
      "alwaysOutputData": true
    },
