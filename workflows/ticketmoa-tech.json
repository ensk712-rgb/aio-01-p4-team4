    {
      "name": "답변 결정",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3000,
        0
      ],
      "parameters": {
        "jsCode": "function readHttp(j) {\n  if (j && typeof j.statusCode === 'number') {\n    const body = j.body && typeof j.body === 'object' ? j.body : {};\n    return { ok: j.statusCode >= 200 && j.statusCode < 300 && !body.error, status: j.statusCode, body };\n  }\n  return { ok: false, status: null, body: {} };\n}\nconst s = $('작성 결과 검사').isExecuted ? $('작성 결과 검사').first().json : $('대체 입장 안내').first().json;\nconst urgent = Boolean(s.urgent_fallback);\nconst alert = urgent ? { channel: 'venue-staff', priority: 'high' } : null;\nconst r = readHttp($json);\nconst verifyCalls = typeof r.body.llm_calls === 'number' ? r.body.llm_calls : 0;\nif (!r.ok || r.body.ok !== true) {\n  return [{ json: { route: '담당자 이관', answer: '', sources: [], alert, llm_calls: urgent ? 1 : 2, reason: r.status === null ? 'verification_timeout' : 'verification_failed', issues: Array.isArray(r.body.issues) ? r.body.issues : [] } }];\n}\nif (urgent) {\n  return [{ json: { route: '담당자 이관', answer: s.answer, sources: s.sources, alert, llm_calls: 1 + verifyCalls, reason: 'urgent_entry' } }];\n}\nreturn [{ json: { route: '자동 답변', answer: s.answer, sources: s.hits.map(h => ({ doc: h.doc, section: h.section, score: h.score })), alert: null, llm_calls: 1 + verifyCalls, reason: '' } }];"
      }
    },
    {
      "name": "근거 없음 결과",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
