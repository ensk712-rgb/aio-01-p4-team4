        "request_id": "wf06",
        "user": "박서준",
        "channel": "web",
        "question": "C-2001 처리 상태 알려 주세요"
      },
      "expect": {
        "equals": {
          "route": "권한 없음"
        },
        "not_contains": {
          "answer": [
            "처리 중",
            "010-0000-4821",
            "mina.jung@example.com"
          ]
        }
      }
