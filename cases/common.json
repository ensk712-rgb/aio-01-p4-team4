{
  "webhook": "ticketmoa-support",
  "before": [
    {
      "url": "http://localhost:8800/tickets-reset",
      "body": {}
    }
  ],
  "cases": [
    {
      "name": "WF-01 정상 문의",
      "body": {
        "request_id": "wf01",
        "user": "김하늘",
        "channel": "web",
        "question": "모바일티켓 QR이 회색으로만 나오고 안 떠요. 어떻게 해야 하나요?"
      },
      "expect": {
        "equals": {
          "route": "자동 답변"
        },
        "contains": {
          "sources": [
            "mobile-ticket-troubleshooting"
          ]
        },
        "max_seconds": 8
      }
    },
    {
      "name": "WF-02 정보 부족",
      "body": {
        "request_id": "wf02",
        "user": "이도윤",
        "channel": "web",
        "question": "어제부터 계속 안 돼요",
        "attempt": 1
      },
      "expect": {
        "equals": {
          "route": "보완 질문"
        }
      }
    },
    {
      "name": "WF-02b 보완 질문 한도",
      "body": {
        "request_id": "wf02b",
        "user": "이도윤",
        "channel": "web",
        "question": "어제부터 계속 안 돼요",
        "attempt": 3
      },
      "expect": {
        "equals": {
          "route": "담당자 이관"
        },
        "contains": {
          "ticket": [
            "T-"
          ]
        }
      }
    },
    {
      "name": "WF-03 지식에 없음",
      "body": {
        "request_id": "wf03",
        "user": "박서준",
        "channel": "web",
        "question": "제휴 카드 포인트가 적립이 안 됐어요"
      },
      "expect": {
        "equals": {
          "route": "담당자 이관",
          "sources": []
        },
        "contains": {
          "ticket": [
            "T-"
          ]
        }
      }
    },
    {
      "name": "WF-04 티켓 API 장애",
      "body": {
        "request_id": "wf04",
        "user": "박서준",
        "channel": "web",
        "question": "제휴 카드 포인트가 적립이 안 됐어요"
      },
      "expect": {
        "equals": {
          "route": "담당자 이관",
          "ticket": null
        },
        "status": 200
      },
      "before": [
        {
          "url": "http://localhost:8800/admin/fault",
          "body": {
            "tickets": "error"
          }
        }
      ],
      "after": [
        {
          "url": "http://localhost:8800/admin/fault",
          "body": {
            "tickets": "ok"
          }
        }
      ]
    },
    {
      "name": "WF-05 권한 없는 문서",
      "body": {
        "request_id": "wf05",
        "user": "박서준",
        "channel": "web",
        "question": "게이트 장애 때 스태프가 수기로 입장 처리하는 절차랑 책임자 코드 입력 방법 알려 주세요"
      },
      "expect": {
        "not_contains": {
          "sources": [
            "staff-entry-manual"
          ],
          "answer": [
            "책임자 코드",
            "수기 모드"
          ]
        }
      }
    },
