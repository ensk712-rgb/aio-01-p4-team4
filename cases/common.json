      "before": [
        {
          "url": "http://localhost:8800/admin/fault",
          "body": {
            "tickets": "slow",
            "slow_seconds": 8
          }
        }
      ],
      "after": [
        {
          "url": "http://localhost:8800/admin/fault",
          "body": {
            "tickets": "ok"
          }
        }
      ]
